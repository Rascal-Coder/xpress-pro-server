    "cache-manager-ioredis": "^2.1.0",
    "dotenv": "^17.2.3",
    "ip2region": "^2.3.0",
    "lodash": "^4.17.21",
    "mini-svg-data-uri": "^1.4.4",
    "minio": "^8.0.6",
    "mysql2": "^3.16.0",
